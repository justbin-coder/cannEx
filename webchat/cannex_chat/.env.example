# CannEx Webchat — 环境变量模板
# 复制为 .env 并按实际环境填写，.env 不要提交到 git

# ── 必填 ──────────────────────────────────────────────────────────────
# 项目根目录，绝对路径，用于定位 workspace/ 与 skills/
CANNEX_ROOT=

# ── 可选 ──────────────────────────────────────────────────────────────
# 推理模型，默认 claude-sonnet-4-6
# CANNEX_MODEL=claude-sonnet-4-6

# 日志目录，默认 ${CANNEX_ROOT}/logs
# CANNEX_LOGS_DIR=

# Anthropic API base URL（使用代理时填写，默认走 Anthropic 官方）
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 服务端兜底 API key（可选；用户通过 BYOK UI 自带 key 时此项可留空）
# ANTHROPIC_API_KEY=

# SKILL.md 路径（默认 ${CANNEX_ROOT}/skills/ascend-c/SKILL.md）
# CANNEX_SKILL_PATH=
