# CannEx deploy/.env — copy to deploy/.env and fill in.
# This file is loaded by docker-compose; do NOT commit deploy/.env to git.

# Chainlit JWT signing secret. Required.
# Generate with: openssl rand -hex 32
CHAINLIT_AUTH_SECRET=

# Shared Claude API key (server-side fallback when user does not BYOK).
# This key is billed by you; rotate if compromised.
ANTHROPIC_API_KEY=

# Anthropic API base URL. Set to bytego proxy for inland access.
# Example: https://api.bytego.example/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: override default model.
# CANNEX_MODEL=claude-sonnet-4-6

# LLM 配置加密密钥（缺省回落 CHAINLIT_AUTH_SECRET）。轮换会使已存用户 key 失效需重填。
CANNEX_CONFIG_SECRET=
