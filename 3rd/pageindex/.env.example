# ============================================================================
# PageIndex 凭据与调优旋钮 · 模板文件
# ----------------------------------------------------------------------------
# 用法：把本文件复制为同目录下的 PageIndex/.env，再填入你自己的凭据。
#   cp 3rd/pageindex/.env.example 3rd/pageindex/PageIndex/.env
# 真实 .env 含密钥，已被 .gitignore 排除，切勿提交。
# ============================================================================

# ── LLM 凭据（二选一，取决于你的中转/网关协议）──────────────────────────────
# 模型名决定 wire protocol（litellm 按前缀路由）：
#   anthropic/xxx  → 走 ANTHROPIC 协议，用下面 ANTHROPIC_* 这组
#   deepseek/xxx   → 走 DeepSeek，用 DEEPSEEK_API_KEY
# 当前 config.yaml 默认 model = anthropic/qwen3-max-2026-01-23，故用 ANTHROPIC 这组。

# DeepSeek（小文档便宜，中文友好）
# DEEPSEEK_API_KEY=sk-你的key

# Anthropic 协议（含各类聚合网关 / 中转，跨转后端模型）
ANTHROPIC_API_KEY=sk-你的key
ANTHROPIC_BASE_URL=https://你的网关地址/api/coding

# ── PageIndex 行为旋钮（均为补丁引入，可不填走默认）──────────────────────────
# 详细成因见 CannEx 项目 CLAUDE.md §六「PageIndex 源码补丁」表。

# 流式开关。某些网关「仅流式」或对非流式有硬性 ~60s 超时 → 置 1 强制流式。
# 逃生阀：置 0 退回非流式。默认 1。
PAGEINDEX_STREAM=1

# 并发上限。聚合网关对高并发敏感（节点 summary / verify_toc 用 asyncio.gather
# 扇出大），撞配额会报 RateLimitError "concurrency quota exceeded"。默认 8，
# 大文档建议下调到 3。
PAGEINDEX_MAX_CONCURRENCY=3

# ── 以下旋钮一般用默认即可，仅在排障时覆盖 ──────────────────────────────────
# PAGEINDEX_MAX_TOKENS=32000          # 单轮输出上限（大 TOC 单轮跑完防截断续写）
# PAGEINDEX_TOC_BATCH_LINES=80        # TOC 分批转换每批行数（防大文档批内复读）
# PAGEINDEX_TIMEOUT=300               # 单请求超时秒数（流式重负载批次实测可达 155s）
# PAGEINDEX_MAX_RETRIES=4             # 单条目最大重试次数（防重试风暴）
# PAGEINDEX_CIRCUIT_THRESHOLD=20      # 熔断阈值：连续失败 N 次中止整个 build
